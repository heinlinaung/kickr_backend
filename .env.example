PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/kickr

APP_BASE_URL=http://localhost:3000

UPLOADS_DIR=./uploads

# AWS Cognito
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_iam_access_key
AWS_SECRET_ACCESS_KEY=your_iam_secret_key
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_app_client_id
COGNITO_CLIENT_SECRET=your_app_client_secret

# Admin endpoints (server-to-server, x-admin-key header).
# Leave BLANK to disable them entirely — they fail closed when unset.
# Anyone holding this key can add any user to any group or event: treat it like
# a root credential and use a long random value.
ADMIN_KEY=

# ImageKit (file storage/CDN)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/kickr
