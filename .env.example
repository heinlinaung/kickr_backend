PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/kickr

APP_BASE_URL=http://localhost:3000
# Optional, comma-separated. Extra browser origins allowed by CORS, for local
# tools served on another port (e.g. http://localhost:8080 for the web-push
# test page). Leave blank in production unless a real second origin needs it.
CORS_EXTRA_ORIGINS=

UPLOADS_DIR=./uploads

# AWS Cognito
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_iam_access_key
AWS_SECRET_ACCESS_KEY=your_iam_secret_key
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_app_client_id
COGNITO_CLIENT_SECRET=your_app_client_secret

# Admin endpoints (server-to-server, x-admin-key header).
# Leave BLANK to disable them entirely — they fail closed when unset.
# Anyone holding this key can add any user to any group or event: treat it like
# a root credential and use a long random value.
ADMIN_KEY=

# ImageKit (file storage/CDN)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/kickr

# Firebase Cloud Messaging — OPTIONAL.
# Leave blank to run without push: the server logs a warning at startup and
# every send becomes a no-op, while the in-app notification list and the
# socket.io channel keep working. Local dev and CI need no Firebase project.
# From the service-account JSON in Firebase console > Project settings >
# Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the "private_key" value from that JSON, as ONE line with literal \n
# sequences. The app strips wrapping quotes and expands the \n itself, so all
# of these work: quoted or unquoted, escaped or real newlines.
#
# For `docker run --env-file` specifically, prefer it UNQUOTED on one line.
# Docker does not strip quotes or process escapes — it takes the raw characters
# after the first `=` — so a quoted value used to arrive with literal quote
# characters attached and failed with "Failed to parse private key". The app now
# tolerates that, but unquoted-single-line is the shape that works everywhere
# and needs no forgiveness.
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n
