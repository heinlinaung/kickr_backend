%% 5.5 Score entry & standings
%% Source of truth for this diagram. Rendered from ../specs/2026-08-03-events-feature-spec.md §5.5
%% Edit here, not in the spec — the spec links to this file.
flowchart LR
    A["PATCH /events/:id/matches/:matchNumber
    {scoreA, scoreB}"] --> B{organizer?}
    B -->|no| B1[403]
    B -->|yes| C{"status in playing,
    after_match?"}
    C -->|no| C1["400 — cannot score
    before kick-off"]
    C -->|yes| D{"findOneAndUpdate on
    {eventId, matchNumber}"}
    D -->|"no row"| D1[404]
    D -->|updated| E["scoreA/scoreB + playedAt set
    both scores required; 0 is valid"]

    E --> F["GET /events/:id/standings
    (also inlined on GET /events/:id)"]
    F --> G["fold over the event's EventMatch rows
    skip any fixture with a null score"]
    G --> H["win 3 / draw 1 / loss 0
    played, W, D, L, GF, GA, GD, pts"]
    H --> I["sort: pts → GD → GF → team name"]
    I --> J[table returned]

    K["team names seeded from the fixture list,
    so a team yet to play still shows a zero row"] -.-> G

    L["after_match is included on purpose —
    a typo can still be corrected
    once the whistle has gone"] -.-> C

    O["one targeted update per fixture, so two
    organizers scoring different matches cannot
    overwrite each other — an embedded array
    could not offer that"] -.-> D

    E --> M["EventMatch is the sole score authority
    for multi-team events"]
    M --> N["Event.result keeps mvpUserId only
    (+ scoreA/scoreB for simple 2-team)"]
