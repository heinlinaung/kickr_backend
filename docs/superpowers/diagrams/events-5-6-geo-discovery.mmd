%% 5.6 Geo discovery
%% Source of truth for this diagram. Rendered from ../specs/2026-08-03-events-feature-spec.md §5.6
%% Edit here, not in the spec — the spec links to this file.
flowchart TD
    A["GET /events?near=lat,lng&radius=5000"] --> B{"near parses as
    two finite numbers?"}
    B -->|no| B1["400 — near must be 'lat,lng'"]
    B -->|yes| C{"lat in -90..90
    lng in -180..180?"}
    C -->|no| C1["400 — outside coordinate range"]
    C -->|yes| D["radius > 0 ? radius : 10 000 m"]

    D --> E["$geoNear on locations.geo
    FIRST stage, 2dsphere index
    coordinates swapped to [lng, lat]"]
    E --> F{"any location in range?"}
    F -->|no| F1["return [] — skip the event query
    rather than $in against []"]
    F -->|yes| G["locationId in the matched ids"]

    G --> H["find events: isPublic true
    + region / status / date filters
    all AND together"]
    H --> I["sort by date ascending
    + derived isFull per row"]

    J["$geoNear must LEAD its pipeline, and events
    hold only a locationId — so the geo query runs
    against locations, then filters events by id.
    Two queries, not a $lookup."] -.-> E

    K["same pitch may exist as several rows,
    one per creator/group (parent §3)"] -.->|"apparent duplicates
    are accepted"| I
